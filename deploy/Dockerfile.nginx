FROM python:3.12-slim-bookworm AS archive
WORKDIR /archive
COPY requirements-archive.txt ./
RUN pip install --no-cache-dir -r requirements-archive.txt
COPY mkdocs.yml ./
COPY docs/ docs/
COPY overrides/ overrides/
RUN mkdocs build --strict

FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=archive /archive/site/ /usr/share/nginx/html/arhiva/
USER 101:101
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
